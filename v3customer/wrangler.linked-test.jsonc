{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "mfk-customer",
  "main": "./linked-test-worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {"MFP_V3_LINKED_TEST_ENABLED": "1"},
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/api", "/media/*"]},
  "r2_buckets": [{"binding": "CUSTOMER_ASSETS", "bucket_name": "mfk-customer-assets"}],
  "durable_objects": {"bindings": [
    {"name": "ADMIN_SYNC", "class_name": "AdminSyncStore", "script_name": "mfk-admin"},
    {"name": "CUSTOMER_RUNTIME", "class_name": "CustomerRuntimeStore", "script_name": "mfk-admin"}
  ]}
}
